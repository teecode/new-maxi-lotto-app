<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 0. One address per page: www.maxilotto.ng served the same site as maxilotto.ng,
                which search engines see as duplicate content. -->
        <rule name="RedirectWwwToApex" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.maxilotto\.ng$" />
          </conditions>
          <action type="Redirect" url="https://maxilotto.ng/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- 1. Simple Reverse Proxy for Socket.io -->
        <rule name="ReverseProxySocketIO" stopProcessing="true">
          <match url="^socket.io(.*)" />
          <action type="Rewrite" url="http://localhost:4000/socket.io{R:1}" />
        </rule>

        <!-- 2. Pages with their own HTML (about.html, auth/signup.html, ...), written at build
                time by scripts/vite-plugin-seo.ts so each page has its own title, description
                and content for crawlers. The app itself is the same as index.html. -->
        <rule name="PrerenderedPages" stopProcessing="true">
          <match url="^(.+)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>

        <!-- 3. SPA Client-Side Routing -->
        <!-- For components like Tanstack Router or React Router. A missing file (a script from
             another build, an image) gets a real 404, not the app's HTML: served as a script,
             that HTML broke the page, and Cloudflare kept it under the file's address for hours. -->
        <rule name="ReactRouterRoutes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{URL}" pattern="^/assets/|\.(js|mjs|css|map|json|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|txt|xml|webmanifest|apk|exe)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>

      <!-- Caching, so a deploy reaches people without a hard refresh. Without a Cache-Control
           header, browsers kept index.html for hours on their own guess and ran the old build. -->
      <outboundRules>
        <!-- Every HTML page (index.html, the per-page files, the SPA fallback): the browser
             always asks for a newer copy, a quick 304 when nothing changed. -->
        <rule name="NoCacheHtml" preCondition="IsHtml">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache" />
        </rule>
        <!-- Files that decide which build runs (the service worker and its loader) or that
             crawlers re-read: never kept by Cloudflare or the browser without asking. -->
        <rule name="NoCacheUpdateFiles">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{URL}" pattern="^/(sw\.js|registerSW\.js|push-sw\.js|manifest\.json|sitemap\.xml|robots\.txt)$" />
          </conditions>
          <action type="Rewrite" value="no-cache" />
        </rule>
        <preConditions>
          <preCondition name="IsHtml">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <!-- IIS refuses to serve extensions it has no MIME type for; this lets /downloads/*.apk download. -->
    <staticContent>
      <remove fileExtension=".apk" />
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
    </staticContent>

  </system.webServer>

  <!-- Built scripts and styles have a content hash in their name, so a file never changes
       under the same name: browsers and Cloudflare may keep them for a year. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
